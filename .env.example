APP_NAME="ISP Billing"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---- Database (MySQL / MariaDB on cPanel) --------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=youruser_wifi
DB_USERNAME=youruser_wifi
DB_PASSWORD=

# ---- Sessions / cache / queue -------------------------------------------
# The database driver keeps everything working on shared hosting where no
# long-running worker process is available.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- MikroTik ------------------------------------------------------------
# Seconds to wait for a RouterOS API response.
MIKROTIK_TIMEOUT=10
# Leave false for self-signed certificates on the router; set true only when
# the router presents a certificate your server can validate.
MIKROTIK_SSL_VERIFY=false

# ---- First-run seeding ---------------------------------------------------
# Set a strong password before running: php artisan db:seed
SEED_ISP_NAME="My ISP"
SEED_ISP_PHONE=
SEED_ISP_EMAIL=
SEED_ISP_ADDRESS=
SEED_ISP_WEBSITE=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME="ISP Administrator"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
